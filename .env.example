# Master secret for end-to-end encryption (generate once and keep it private)
HANDY_MASTER_SECRET=

# Public URL used for generated file URLs sent to clients
PUBLIC_URL=http://localhost:3005

# Server
PORT=3005
HOST=0.0.0.0
NODE_ENV=production
TZ=UTC

# Standalone Docker storage defaults
DATA_DIR=/data
PGLITE_DIR=/data/pglite
DB_PROVIDER=pglite

# Optional integrations
# ELEVENLABS_API_KEY=
# REVENUECAT_API_KEY=

# Debug (optional)
# DANGEROUSLY_LOG_TO_SERVER_FOR_AI_AUTO_DEBUGGING=true
